# Public origin of the site, without a trailing slash, even when the site is
# hosted elsewhere (e.g. Netlify). Used for canonical links and the sitemap
# (baked in at build time), the WCA OAuth callback
# (<PUBLIC_URL>/regional-rankings) and the default CORS origin.
PUBLIC_URL=http://localhost:8000
PORT=8000
# Apps built into the image, as app directories. "admin" when the public site
# is hosted elsewhere; empty builds every app.
SITES=

# WCA OAuth application. The client ID is also baked into the public site.
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=
# WCA_BASE_URL=https://www.worldcubeassociation.org
# WCA_EXPORT_API_URL=https://www.worldcubeassociation.org/api/v0/export/public

# Google Analytics 4 measurement ID for the public site (optional).
GA_MEASUREMENT_ID=

FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_PAGE_FEED_LIMIT=5

# Creates (or resets the password of) this staff account on API start.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-please
# Set when the site is served over HTTPS.
ADMIN_SECURE_COOKIES=0
# Queue a statistics rebuild after admin region changes.
AUTO_REBUILD_STATISTICS=1
# Admin database backups kept in DATA_DIR/backups (about 20 MB each).
BACKUP_KEEP=5

# Comma-separated browser origins allowed to call the public API. Defaults to
# PUBLIC_URL; list extra origins (e.g. Netlify deploy previews) here.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=0

# 1 counts only users linked to a WCA account in regional and zonal rankings.
# The 2026 database has no linked accounts, so this is off by default.
RANKINGS_REQUIRE_WCA_ACCOUNT=0

# Extra backend services served on the same port, as PREFIX=URL pairs
# separated by commas, e.g. /api/shop=http://shop:9000
UPSTREAMS=

# Worker: default WCA sync schedule (cron, Asia/Manila time; empty turns it
# off) and polling intervals. A schedule set on the admin Jobs page overrides it.
SYNC_CRON=0 4 * * *
JOB_POLL_INTERVAL=2s
CACHE_POLL_INTERVAL=2s

# Where the seed database and its manifest live (mounted read-only).
# SEED_DIR=./archive/web-backend/data
# SEED_DATABASE=rebuilt-october-2026.sqlite3
# SEED_MANIFEST=rebuilt-october-2026-manifest.json
